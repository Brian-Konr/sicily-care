{
  "name": "sicily-care",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "西西里共同照護紀錄 PWA（Vite + React + TS + Tailwind v4 + shadcn/ui；後端 Apps Script）",
  "scripts": {
    "sync-tokens": "node scripts/sync-tokens.mjs",
